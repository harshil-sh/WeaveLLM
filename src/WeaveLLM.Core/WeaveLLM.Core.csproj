<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeaveLLM.Core</RootNamespace>
    <AssemblyName>WeaveLLM.Core</AssemblyName>

    <PackageId>WeaveLLM.Core</PackageId>
    <Version>0.1.0-alpha</Version>
    <Description>Core abstractions for WeaveLLM — the AI orchestration framework for .NET</Description>
    <PackageTags>ai;llm;langchain;dotnet;csharp;rag;agents;openai;anthropic;semantic-kernel</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\NUGET_README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
