<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeaveLLM.Testing</RootNamespace>
    <AssemblyName>WeaveLLM.Testing</AssemblyName>

    <PackageId>WeaveLLM.Testing</PackageId>
    <Version>0.2.0-alpha</Version>
    <Description>Pre-built test doubles and fakes for unit-testing WeaveLLM integrations — no real API calls required.</Description>
    <PackageTags>ai;llm;weavellm;testing;fakes;test-doubles;xunit;dotnet</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaveLLM.Core\WeaveLLM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\NUGET_README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
